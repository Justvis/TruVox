<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

   <style name="Theme.TruVox" parent="Theme.MaterialComponents.DayNight.NoActionBar.Bridge">
   </style>

    <!-- Custom Rounded Button Style -->
    <style name="truButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">#242483</item>
        <item name="android:background">@drawable/tru_button</item>
        <item name="android:padding">12dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

</resources>
